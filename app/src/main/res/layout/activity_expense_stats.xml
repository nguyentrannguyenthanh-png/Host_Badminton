<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="24dp"
            android:text="Quản Lý Chi Phí &amp; Thống Kê"
            android:textColor="@color/text_white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/dark_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nhập Chi Phí Buổi Đánh (VNĐ)"
                    android:textColor="@color/neon_green"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Tiền thuê sân:"
                    android:textColor="@color/text_white" />

                <EditText
                    android:id="@+id/etCourtFee"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_input_dark"
                    android:hint="Ví dụ: 300000"
                    android:textColor="@color/text_white"
                    android:textColorHint="@color/text_gray"
                    android:inputType="numberDecimal"
                    android:padding="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Tiền mua cầu:"
                    android:textColor="@color/text_white" />

                <EditText
                    android:id="@+id/etShuttleFee"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_input_dark"
                    android:hint="Ví dụ: 200000"
                    android:textColor="@color/text_white"
                    android:textColorHint="@color/text_gray"
                    android:inputType="numberDecimal"
                    android:padding="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Chi phí khác (Nước uống, phụ phí...):"
                    android:textColor="@color/text_white" />

                <EditText
                    android:id="@+id/etOtherFee"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_input_dark"
                    android:hint="Ví dụ: 50000"
                    android:textColor="@color/text_white"
                    android:textColorHint="@color/text_gray"
                    android:inputType="numberDecimal"
                    android:padding="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Ghi chú / Số tài khoản nhận tiền (STK):"
                    android:textColor="@color/text_white" />

                <EditText
                    android:id="@+id/etExpenseNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_dark"
                    android:hint="Ví dụ: VCB 123456789 - Nguyen Van A"
                    android:textColor="@color/text_white"
                    android:textColorHint="@color/text_gray"
                    android:inputType="textMultiLine"
                    android:padding="12dp" />

                <Button
                    android:id="@+id/btnSaveAndCalculate"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="@color/neon_green"
                    android:text="Lưu Chi Phí &amp; Tính Tiền Chia Đều"
                    android:textColor="@color/dark_bg"
                    android:textStyle="bold"
                    app:cornerRadius="27dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>