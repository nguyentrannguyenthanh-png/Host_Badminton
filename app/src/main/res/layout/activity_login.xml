<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_btn_secondary"
            android:padding="16dp"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Host Badminton"
            android:textColor="@color/text_white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTitleMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="ĐĂNG NHẬP TÀI KHOẢN CHỦ SÂN"
            android:textColor="@color/text_gray"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Tên tài khoản"
                android:textColor="@color/text_white" />

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_input_dark"
                android:hint="Tên tài khoản"
                android:padding="12dp"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_gray" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Mật khẩu"
                android:textColor="@color/text_white" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_input_dark"
                android:hint="Mật khẩu"
                android:inputType="textPassword"
                android:padding="12dp"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_gray" />

            <!-- KHU VỰC ĐĂNG KÝ (ẨN MẶC ĐỊNH KHI ĐĂNG NHẬP) -->
            <LinearLayout
                android:id="@+id/layoutRegisterFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Số điện thoại"
                    android:textColor="@color/text_white" />

                <EditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_input_dark"
                    android:hint="Số điện thoại"
                    android:inputType="phone"
                    android:padding="12dp"
                    android:textColor="@color/text_white"
                    android:textColorHint="@color/text_gray" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbRemember"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:buttonTint="@color/neon_green"
                android:text="Ghi nhớ mật khẩu"
                android:textColor="@color/text_gray" />

            <!-- Các ID ẩn để tương thích code Java cũ -->
            <CheckBox android:id="@+id/cbRememberPass" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <Button android:id="@+id/btnSubmit" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <EditText android:id="@+id/etOtp" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <Button android:id="@+id/btnSendOtp" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/neon_green"
                android:text="ĐĂNG NHẬP"
                android:textColor="@color/dark_bg"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="27dp" />

            <Button
                android:id="@+id/btnSwitchMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/transparent"
                android:text="Đăng ký ngay"
                android:textAllCaps="false"
                android:textColor="@color/neon_green"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnForgotPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/transparent"
                android:text="Quên mật khẩu?"
                android:textAllCaps="false"
                android:textColor="@color/text_gray"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>