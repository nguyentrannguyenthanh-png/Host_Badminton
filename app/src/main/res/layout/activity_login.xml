<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/dark_bg" android:orientation="vertical"
    android:gravity="center" android:padding="24dp">
    
    <ImageView android:layout_width="120dp" android:layout_height="120dp" 
        android:src="@mipmap/ic_launcher" android:layout_marginBottom="24dp"
        android:background="@drawable/bg_btn_primary" android:padding="8dp"/>
        
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" 
        android:text="Host Badminton" android:textColor="@color/text_white" 
        android:textSize="28sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
        
    <TextView android:id="@+id/tvTitleMode" android:layout_width="wrap_content" android:layout_height="wrap_content" 
        android:text="ĐĂNG NHẬP TÀI KHOẢN CHỦ SÂN" android:textColor="@color/text_white" 
        android:textSize="18sp" android:textStyle="bold" android:layout_marginBottom="32dp"/>
    
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" 
        android:background="@drawable/bg_card_dark" android:orientation="vertical" android:padding="20dp">
        
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" 
            android:text="Tên tài khoản" android:textColor="@color/text_white" android:layout_marginBottom="8dp"/>
        <EditText android:id="@+id/etUsername" android:layout_width="match_parent" android:layout_height="50dp" 
            android:background="@drawable/bg_input_dark" android:padding="12dp" 
            android:textColor="@color/text_white" android:textColorHint="@color/text_gray" 
            android:hint="Tên tài khoản" android:layout_marginBottom="16dp"/>
        
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" 
            android:text="Mật khẩu" android:textColor="@color/text_white" android:layout_marginBottom="8dp"/>
        <EditText android:id="@+id/etPassword" android:layout_width="match_parent" android:layout_height="50dp" 
            android:background="@drawable/bg_input_dark" android:padding="12dp" 
            android:textColor="@color/text_white" android:textColorHint="@color/text_gray" 
            android:hint="Mật khẩu" android:inputType="textPassword" android:layout_marginBottom="16dp"/>
        
        <CheckBox android:id="@+id/cbRemember" android:layout_width="match_parent" android:layout_height="wrap_content" 
            android:text="Ghi nhớ mật khẩu" android:textColor="@color/text_gray" 
            android:buttonTint="@color/neon_green" android:layout_marginBottom="24dp"/>
        
        <Button android:id="@+id/btnLogin" android:layout_width="match_parent" android:layout_height="54dp" 
            android:backgroundTint="@color/neon_green" android:text="ĐĂNG NHẬP" 
            android:textColor="@color/dark_bg" android:textSize="16sp" android:textStyle="bold" app:cornerRadius="27dp"/>
            
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" 
            android:text="Chưa có tài khoản? Đăng ký ngay" android:textColor="@color/text_gray" 
            android:gravity="center" android:layout_marginTop="16dp" android:textSize="13sp"/>
    </LinearLayout>
</LinearLayout>