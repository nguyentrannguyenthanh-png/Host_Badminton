<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_card_dark" android:layout_marginBottom="12dp"
    android:padding="16dp" android:orientation="horizontal" android:gravity="center_vertical">

    <TextView android:id="@+id/tvPlayerInitials" android:layout_width="50dp" android:layout_height="50dp"
        android:background="@drawable/bg_btn_secondary" android:gravity="center"
        android:text="PL" android:textColor="@color/neon_green" android:textSize="18sp" android:textStyle="bold" />

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="16dp" android:orientation="vertical">
        <TextView android:id="@+id/tvPlayerInfo" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Tên Cầu Thủ" android:textColor="@color/text_white" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvMatchCount" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0 buổi • 0 set" android:textColor="@color/text_gray" android:textSize="12sp" android:layout_marginTop="4dp" />
    </LinearLayout>

    <Switch android:id="@+id/swPlayerStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:checked="true" android:thumbTint="@color/white" android:trackTint="@color/neon_green" />
</LinearLayout>