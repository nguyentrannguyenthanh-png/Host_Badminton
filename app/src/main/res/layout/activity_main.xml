<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/dark_bg">

    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:layout_above="@id/bottomNav">
        
        <!-- TAB 0: TRANG CHỦ (HOME / XẾP TRẬN) -->
        <ScrollView android:id="@+id/layoutHome" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="visible">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trang chủ" android:textColor="@color/text_white" android:textSize="24sp" android:textStyle="bold" android:layout_marginBottom="16dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btnSuggestMatch" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:backgroundTint="@color/neon_green" android:textColor="@color/dark_bg" android:text="Tự Động" app:cornerRadius="12dp"/>
                    <Button android:id="@+id/btnManualMatch" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="8dp" android:backgroundTint="@color/dark_input" android:textColor="@color/text_white" android:text="Thủ Công" app:cornerRadius="12dp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                    <Button android:id="@+id/btnUndoMatch" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:backgroundTint="@color/dark_input" android:textColor="@color/text_white" android:text="Hủy Trận" app:cornerRadius="12dp"/>
                    <Button android:id="@+id/btnViewHistory" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="8dp" android:backgroundTint="@color/dark_input" android:textColor="@color/text_white" android:text="Lịch Sử" app:cornerRadius="12dp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp" android:layout_marginBottom="16dp">
                    <Button android:id="@+id/btnReset" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:backgroundTint="@color/dark_input" android:textColor="@color/text_white" android:text="Làm Mới" app:cornerRadius="12dp"/>
                    <Button android:id="@+id/btnReload" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="8dp" android:backgroundTint="@color/dark_input" android:textColor="@color/text_white" android:text="Tải Lại" app:cornerRadius="12dp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trận Đấu Đang Diễn Ra" android:textColor="@color/text_white" android:textSize="18sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>
                <TextView android:id="@+id/tvMatchResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card_dark" android:padding="16dp" android:text="Chưa có trận đấu nào được xếp" android:textColor="@color/text_gray" android:textSize="14sp"/>
            </LinearLayout>
        </ScrollView>

        <!-- TAB 1: CHI PHÍ (EXPENSE) -->
        <ScrollView android:id="@+id/layoutExpenseStats" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chi phí &amp; Thống kê" android:textColor="@color/text_white" android:textSize="24sp" android:textStyle="bold" android:layout_marginBottom="16dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tổng chi phí" android:textColor="@color/text_gray"/>
                <TextView android:id="@+id/tvTotalExpense" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0đ" android:textColor="@color/text_white" android:textSize="28sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvPlayerCountSummary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Số người tham gia: 0" android:textColor="@color/text_gray" android:layout_marginBottom="16dp"/>
                
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card_neon" android:orientation="vertical" android:padding="16dp" android:layout_marginBottom="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:id="@+id/tvCostPerPlayer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mỗi người đóng: 0đ" android:textColor="@color/text_white" android:textSize="16sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đã bao gồm tiền nước" android:textColor="@color/text_gray" android:textSize="12sp"/>
                        </LinearLayout>
                        <ImageView android:id="@+id/ivQrCodePreview" android:layout_width="48dp" android:layout_height="48dp" android:background="@color/white" android:visibility="gone"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card_dark" android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Tiền sân" android:textColor="@color/text_white"/>
                    <EditText android:id="@+id/etCourtFee" android:layout_width="150dp" android:layout_height="wrap_content" android:background="@color/transparent" android:hint="0đ" android:textColor="@color/text_white" android:textColorHint="@color/text_gray" android:gravity="end" android:inputType="numberDecimal"/>
                </LinearLayout>
                
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card_dark" android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical" android:layout_marginBottom="16dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Tiền cầu" android:textColor="@color/text_white"/>
                    <EditText android:id="@+id/etShuttleFee" android:layout_width="150dp" android:layout_height="wrap_content" android:background="@color/transparent" android:hint="0đ" android:textColor="@color/text_white" android:textColorHint="@color/text_gray" android:gravity="end" android:inputType="numberDecimal"/>
                </LinearLayout>

                <!-- Hidden inputs to prevent crashes -->
                <EditText android:id="@+id/etOtherFee" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <EditText android:id="@+id/etExpenseNote" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <EditText android:id="@+id/etFixedFeePerPlayer" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <EditText android:id="@+id/etShuttlesUsed" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <CheckBox android:id="@+id/cbFixedFeeMode" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <CheckBox android:id="@+id/cbUseInventoryShuttle" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <LinearLayout android:id="@+id/layoutFixedFeeInput" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <LinearLayout android:id="@+id/layoutInventoryShuttleCalc" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <TextView android:id="@+id/tvStockStatus" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <TextView android:id="@+id/tvGenderBreakdown" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <TextView android:id="@+id/tvHostBalance" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <Button android:id="@+id/btnSelectQrCode" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card_dark" android:orientation="vertical" android:padding="16dp" android:layout_marginBottom="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Thu riêng Nam / Nữ" android:textColor="@color/text_white"/>
                        <CheckBox android:id="@+id/cbSeparateGenderFee" android:layout_width="wrap_content" android:layout_height="wrap_content" android:buttonTint="@color/neon_green"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/layoutSeparateGenderInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp" android:visibility="gone">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nam:" android:textColor="@color/text_gray" android:layout_gravity="center_vertical"/>
                        <EditText android:id="@+id/etMaleFee" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@color/transparent" android:hint="0đ" android:textColor="@color/text_white" android:textColorHint="@color/text_gray" android:inputType="numberDecimal" android:layout_marginStart="8dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nữ:" android:textColor="@color/text_gray" android:layout_gravity="center_vertical" android:layout_marginStart="16dp"/>
                        <EditText android:id="@+id/etFemaleFee" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@color/transparent" android:hint="0đ" android:textColor="@color/text_white" android:textColorHint="@color/text_gray" android:inputType="numberDecimal" android:layout_marginStart="8dp"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btnSaveAndCalculate" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:backgroundTint="@color/neon_green" android:textColor="@color/dark_bg" android:text="Lưu &amp; Tính tiền" app:cornerRadius="27dp"/>
                    <Button android:id="@+id/btnShareExpenseReport" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:layout_marginStart="12dp" android:background="@drawable/bg_btn_secondary" android:textColor="@color/neon_green" android:text="Chia sẻ Zalo" app:cornerRadius="27dp"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- TAB 2: THÀNH VIÊN (MEMBERS) -->
        <ScrollView android:id="@+id/layoutMembers" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Thành viên" android:textColor="@color/text_white" android:textSize="24sp" android:textStyle="bold"/>
                    <Button android:id="@+id/btnAddPlayer" android:layout_width="wrap_content" android:layout_height="40dp" android:background="@drawable/bg_btn_secondary" android:textColor="@color/neon_green" android:text="+ Thêm" android:textAllCaps="false"/>
                </LinearLayout>
                
                <!-- Hidden inputs for adding players to keep logic intact -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <EditText android:id="@+id/etPlayerName" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    <Spinner android:id="@+id/spinnerGender" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    <Spinner android:id="@+id/spinnerSkill" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/layoutPlayerListContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            </LinearLayout>
        </ScrollView>

        <!-- TAB 3: CÁ NHÂN (PROFILE) -->
        <ScrollView android:id="@+id/layoutProfile" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cá nhân" android:textColor="@color/text_white" android:textSize="24sp" android:textStyle="bold" android:layout_marginBottom="16dp"/>
                
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card_dark" android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical" android:layout_marginBottom="16dp">
                    <ImageView android:layout_width="60dp" android:layout_height="60dp" android:src="@mipmap/ic_launcher"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chủ sân Host" android:textColor="@color/text_white" android:textSize="18sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Host • Hệ thống" android:textColor="@color/text_gray" android:textSize="14sp"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card_dark" android:orientation="vertical" android:layout_marginBottom="16dp">
                    <Button android:id="@+id/btnManageShuttleStock" android:layout_width="match_parent" android:layout_height="60dp" android:background="@color/transparent" android:gravity="start|center_vertical" android:text="Quản lý kho cầu" android:textColor="@color/text_white" android:textAllCaps="false" android:paddingStart="16dp"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/stroke_color"/>
                    <Button android:id="@+id/btnViewRevenueReport" android:layout_width="match_parent" android:layout_height="60dp" android:background="@color/transparent" android:gravity="start|center_vertical" android:text="Báo cáo doanh thu" android:textColor="@color/text_white" android:textAllCaps="false" android:paddingStart="16dp"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/stroke_color"/>
                    <Button android:id="@+id/btnSaveSessionReport" android:layout_width="match_parent" android:layout_height="60dp" android:background="@color/transparent" android:gravity="start|center_vertical" android:text="Chốt lưu buổi đánh" android:textColor="@color/text_white" android:textAllCaps="false" android:paddingStart="16dp"/>
                </LinearLayout>

                <Button android:id="@+id/btnLogout" android:layout_width="match_parent" android:layout_height="54dp" android:background="@drawable/bg_btn_secondary" android:textColor="@color/brand_pink" android:text="Đăng xuất"/>
                
                <!-- Hidden Stats components to prevent crash -->
                <TextView android:id="@+id/tvStatsOverview" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <TextView android:id="@+id/tvTopPlayers" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout android:id="@+id/bottomNav" android:layout_width="match_parent" android:layout_height="70dp" android:layout_alignParentBottom="true" android:background="@drawable/bg_bottom_nav" android:orientation="horizontal" android:elevation="16dp">
        <LinearLayout android:id="@+id/btnTabHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:id="@+id/ivTabHome" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_home" app:tint="@color/text_gray"/>
            <TextView android:id="@+id/tvTabHomeText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trang chủ" android:textColor="@color/text_gray" android:textSize="12sp" android:layout_marginTop="4dp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/btnTabExpense" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:id="@+id/ivTabExpense" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_expense" app:tint="@color/text_gray"/>
            <TextView android:id="@+id/tvTabExpenseText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chi phí" android:textColor="@color/text_gray" android:textSize="12sp" android:layout_marginTop="4dp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/btnTabMembers" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:id="@+id/ivTabMembers" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_members" app:tint="@color/text_gray"/>
            <TextView android:id="@+id/tvTabMembersText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thành viên" android:textColor="@color/text_gray" android:textSize="12sp" android:layout_marginTop="4dp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/btnTabProfile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:id="@+id/ivTabProfile" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_profile" app:tint="@color/text_gray"/>
            <TextView android:id="@+id/tvTabProfileText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cá nhân" android:textColor="@color/text_gray" android:textSize="12sp" android:layout_marginTop="4dp"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>